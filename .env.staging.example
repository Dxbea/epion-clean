# Copy to .env.staging on the VPS. Never commit the filled file.
# This stack is intentionally distinct from production.

NODE_ENV=staging
PORT=5175
EPION_STAGING_IMAGE_TAG=2026-07-19

# PostgreSQL / pgvector (internal Docker network only)
POSTGRES_DB=epion_staging
POSTGRES_USER=epion_staging
POSTGRES_PASSWORD=CHANGE_ME_LONG_UNIQUE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://epion_staging:CHANGE_ME_LONG_UNIQUE_POSTGRES_PASSWORD@postgres:5432/epion_staging?schema=public

# Redis / BullMQ (internal Docker network only)
REDIS_PASSWORD=CHANGE_ME_LONG_UNIQUE_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_UNIQUE_REDIS_PASSWORD@redis:6379

# Public staging API and frontend origins
FRONTEND_ORIGIN=https://staging.epion.app
CORS_EXTRA_ORIGINS=https://api-staging.epion.app
BETTER_AUTH_URL=https://api-staging.epion.app
BETTER_AUTH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
BETTER_AUTH_TRUSTED_ORIGINS=https://staging.epion.app
CSRF_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS

# AI services
OPENAI_API_KEY=
MISTRAL_API_KEY=
SERPER_API_KEY=
SENTRY_DSN=

# Controlled staging source. Must be HTTPS and dedicated to this test.
STAGING_EDITORIAL_FEED_URL=https://example.invalid/epion-staging-feed.xml
STAGING_ADMIN_OVERVIEW_URL=https://api-staging.epion.app/api/admin/editorial-ops/overview
# Inject only for the readiness HTTP probe; never commit a real session cookie.
STAGING_ADMIN_SESSION_COOKIE=

# Discovery: manual jobs only, never scheduled.
DISCOVERY_ENABLED=true
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_KILL_SWITCH=false
DISCOVERY_WORKER_CONCURRENCY=1

# Document corpus
DOCUMENT_PIPELINE_ENABLED=true
DOCUMENT_PIPELINE_KILL_SWITCH=false
DOCUMENT_PIPELINE_WORKER_CONCURRENCY=1

# Strict shadow pipeline
EDITORIAL_SHADOW_ENABLED=true
EDITORIAL_SHADOW_KILL_SWITCH=false
EDITORIAL_SHADOW_WORKER_CONCURRENCY=1
EDITORIAL_BRIEF_ENABLED=true
EDITORIAL_BRIEF_KILL_SWITCH=false
EDITORIAL_BRIEF_WORKER_CONCURRENCY=1
EDITORIAL_BRIEF_MODEL=gpt-4o-mini
EDITORIAL_DRAFT_ENABLED=true
EDITORIAL_VALIDATION_MODE=human_review
EDITORIAL_DRAFT_KILL_SWITCH=false
EDITORIAL_DRAFT_WORKER_CONCURRENCY=1
EDITORIAL_DRAFT_MODEL=gpt-4o-mini
EDITORIAL_CRITIC_MODEL=gpt-4o-mini
EDITORIAL_VERIFICATION_WORKER_ENABLED=true
EDITORIAL_VERIFICATION_KILL_SWITCH=false
EDITORIAL_VERIFICATION_WORKER_CONCURRENCY=1

# Conservative limits for one controlled E2E run.
EDITORIAL_VERIFICATION_MAX_DAILY_RUNS=5
EDITORIAL_VERIFICATION_MAX_DAILY_SERPER=20
EDITORIAL_VERIFICATION_MAX_DAILY_MISTRAL=5
EDITORIAL_VERIFICATION_MAX_DAILY_OPENAI=30
EDITORIAL_VERIFICATION_MAX_DAILY_COST_MICROS=1000000

# Operations are observability-only. No replay mutations for this first run.
EDITORIAL_SHADOW_CALIBRATION_ENABLED=true
EDITORIAL_SHADOW_OPS_MUTATIONS_ENABLED=false
EDITORIAL_SHADOW_OPS_KILL_SWITCH=true

# Non-negotiable: all known auto-publication flags are explicit false.
EDITORIAL_AUTOPUBLISH_ENABLED=false
EDITORIAL_AUTO_PUBLISH_ENABLED=false
AUTO_PUBLISH_ENABLED=false
