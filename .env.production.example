# =============================================================================
# Epion Production Environment Variables
# Copy to .env.production and fill in real values
# =============================================================================

# --- App ---
NODE_ENV=production
PORT=5175

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_DB=epion
POSTGRES_USER=epion
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://epion:CHANGE_ME_STRONG_PASSWORD@postgres:5432/epion

# --- Redis (BullMQ / Cache) ---
REDIS_URL=redis://redis:6379

# --- Auth (Better Auth) ---
BETTER_AUTH_URL=https://api.epion.app
BETTER_AUTH_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
BETTER_AUTH_TRUSTED_ORIGINS=https://epion.app,https://www.epion.app

# --- CORS ---
FRONTEND_ORIGIN=https://epion.app
CORS_EXTRA_ORIGINS=https://www.epion.app,https://api.epion.app

# --- CSRF ---
CSRF_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET

# --- AI / LLM API Keys ---
OPENAI_API_KEY=
MISTRAL_API_KEY=
SERPER_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
GOOGLE_FACT_CHECK_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Feature Flags ---
BETA_MODE=false

# --- Production shadow editorial test (disabled by default; no publication path) ---
EPION_PROD_SHADOW_ENABLED=false
EDITORIAL_VALIDATION_MODE=human_review
EDITORIAL_AUTOMATION_ENABLED=false
EDITORIAL_AUTOMATION_KILL_SWITCH=true
EDITORIAL_AUTOMATION_INTERVAL_MS=300000
EDITORIAL_AUTOMATION_MAXIMUM_DOCUMENTS=12
EDITORIAL_AUTOMATION_INDEXED_LOOKBACK_HOURS=24
EDITORIAL_AUTOMATION_SOURCE_KEYS=
EDITORIAL_AUTOPUBLISH_ENABLED=false
EDITORIAL_AUTOPUBLISH_KILL_SWITCH=true
EDITORIAL_AUTOPUBLISH_MAX_PER_DAY=1
EDITORIAL_AUTOPUBLISH_MINIMUM_SOURCES=2
EDITORIAL_AUTOPUBLISH_MINIMUM_DOMAINS=2
EDITORIAL_AUTOPUBLISH_SYSTEM_USER_ID=
PROD_SHADOW_EDITORIAL_FEED_URL=
PROD_SHADOW_MAX_DOCUMENTS=1
PROD_SHADOW_MAX_TOPICS=1
