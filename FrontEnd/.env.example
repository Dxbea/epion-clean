# Epion Frontend environment example
# Copy to .env.local for local development if needed.

# Required for production deployments. Development defaults to http://localhost:5175 when omitted.
VITE_API_URL=http://localhost:5175

# Optional. When empty, Sentry is disabled in the frontend.
VITE_SENTRY_DSN=

# Optional Google Analytics measurement ID. Leave empty to disable GA calls.
VITE_GA_ID=
