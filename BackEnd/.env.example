# DEBUT BLOC (remplace tout ce qui est entre ce commentaire et "FIN BLOC")
PORT=5175
NODE_ENV=development

# Frontend autorisé par CORS (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Origines CORS supplémentaires autorisées par le middleware Express cors()
# Format : virgule-séparé, sans espaces, URLs complètes sans chemin ni slash final
# ⚠️  Distincte de BETTER_AUTH_TRUSTED_ORIGINS (qui ne contrôle que Better Auth, pas CORS Express)
# Ajouter https://localhost pour l'app Android Capacitor (androidScheme: https)
CORS_EXTRA_ORIGINS=https://localhost

# CSRF
CSRF_SECRET=replace_me_with_a_long_random_csrf_secret
ENABLE_DEBUG_ROUTES=false


# Better Auth
BETTER_AUTH_URL=http://localhost:5175
BETTER_AUTH_SECRET=replace_me_with_a_long_random_better_auth_secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,https://epion.app,https://www.epion.app,https://localhost


# Optional local admin promotion. The Better Auth user must already exist.
SEED_ADMIN_EMAIL=

# DB
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"

# Automatic newsroom discovery (safe defaults: fully disabled)
DISCOVERY_ENABLED=false
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_KILL_SWITCH=true
DISCOVERY_WORKER_CONCURRENCY=1
DISCOVERY_SCHEDULER_POLL_MS=60000
DISCOVERY_SCHEDULER_LOCK_TTL_MS=55000
DISCOVERY_SOURCE_LOCK_TTL_MS=900000
EDITORIAL_GDELT_DISCOVERY_ENABLED=false
EDITORIAL_GDELT_DISCOVERY_KILL_SWITCH=true
# Controlled production profile: enable GDELT only, set its kill switch to false,
# and keep 1 query / 10 results per run. See .env.production.controlled.example.
EDITORIAL_GDELT_MAX_QUERIES_PER_RUN=1
EDITORIAL_GDELT_MAX_RESULTS_PER_RUN=10
EDITORIAL_GOOGLE_NEWS_DISCOVERY_ENABLED=false
EDITORIAL_GOOGLE_NEWS_DISCOVERY_KILL_SWITCH=true
EDITORIAL_GOOGLE_NEWS_MAX_QUERIES_PER_RUN=2
EDITORIAL_GOOGLE_NEWS_MAX_RESULTS_PER_RUN=10
LEGACY_NEWS_DIRECT_ARTICLE_ENABLED=true

# Documentary corpus processing (safe defaults: fully disabled)
DOCUMENT_PIPELINE_ENABLED=false
DOCUMENT_PIPELINE_KILL_SWITCH=true
DOCUMENT_PIPELINE_WORKER_CONCURRENCY=1
DOCUMENT_PIPELINE_LOCK_TTL_MS=900000
DOCUMENT_PIPELINE_PAUSED_JOB_DELAY_MS=60000
# Optional accounting rate; no cost is inferred when unset.
DOCUMENT_EMBEDDING_COST_MICROS_PER_MILLION_TOKENS=

# Editorial topic clustering (shadow-only, no Article creation)
EDITORIAL_SHADOW_ENABLED=false
EDITORIAL_SHADOW_KILL_SWITCH=true
EDITORIAL_SHADOW_WORKER_CONCURRENCY=1
EDITORIAL_SHADOW_RUN_LOCK_TTL_MS=1200000
EDITORIAL_SHADOW_PAUSED_JOB_DELAY_MS=60000

# Factual editorial dossiers and briefs (shadow-only, no Article creation)
EDITORIAL_BRIEF_ENABLED=false
EDITORIAL_BRIEF_KILL_SWITCH=true
EDITORIAL_BRIEF_WORKER_CONCURRENCY=1
EDITORIAL_BRIEF_RUN_LOCK_TTL_MS=1200000
EDITORIAL_BRIEF_PAUSED_JOB_DELAY_MS=60000
EDITORIAL_BRIEF_MODEL=gpt-4o-mini
# Optional accounting rates; no cost is inferred when unset.
EDITORIAL_BRIEF_INPUT_COST_MICROS_PER_MILLION_TOKENS=
EDITORIAL_BRIEF_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=

# Controlled editorial draft generation (disabled, manual queue only)
EDITORIAL_DRAFT_ENABLED=false
EDITORIAL_VALIDATION_MODE=human_review
EDITORIAL_DRAFT_KILL_SWITCH=true
EDITORIAL_DRAFT_WORKER_CONCURRENCY=1
EDITORIAL_AUTOMATION_ENABLED=false
EDITORIAL_AUTOMATION_KILL_SWITCH=true
EDITORIAL_AUTOMATION_INTERVAL_MS=300000
EDITORIAL_AUTOMATION_MAXIMUM_DOCUMENTS=12
EDITORIAL_AUTOMATION_INDEXED_LOOKBACK_HOURS=24
EDITORIAL_AUTOMATION_SOURCE_KEYS=
EDITORIAL_AUTOPUBLISH_ENABLED=false
EDITORIAL_AUTOPUBLISH_KILL_SWITCH=true
EDITORIAL_AUTOPUBLISH_MAX_PER_DAY=1
EDITORIAL_AUTOPUBLISH_MINIMUM_SOURCES=2
EDITORIAL_AUTOPUBLISH_MINIMUM_DOMAINS=2
EDITORIAL_AUTOPUBLISH_SYSTEM_USER_ID=
# HTTPS origin used by the anonymous post-publication smoke test, for example https://epion.app
EDITORIAL_PUBLIC_API_BASE_URL=
EDITORIAL_DRAFT_RUN_LOCK_TTL_MS=1500000
EDITORIAL_DRAFT_PAUSED_JOB_DELAY_MS=60000
EDITORIAL_DRAFT_MODEL=gpt-4o-mini
EDITORIAL_CRITIC_MODEL=gpt-4o-mini
EDITORIAL_DRAFT_INPUT_COST_MICROS_PER_MILLION_TOKENS=
EDITORIAL_DRAFT_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
EDITORIAL_CRITIC_INPUT_COST_MICROS_PER_MILLION_TOKENS=
EDITORIAL_CRITIC_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
# FIN BLOC

# AI APIs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
MISTRAL_API_KEY=
