# DEBUT BLOC (remplace tout ce qui est entre ce commentaire et "FIN BLOC")
PORT=5175
NODE_ENV=development

# Frontend autorisé par CORS (Vite)
FRONTEND_ORIGIN=http://localhost:5173

# CSRF
CSRF_SECRET=replace_me_with_a_long_random_csrf_secret
ENABLE_DEBUG_ROUTES=false

# Better Auth
BETTER_AUTH_URL=http://localhost:5175
BETTER_AUTH_SECRET=replace_me_with_a_long_random_better_auth_secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,https://epion.app,https://www.epion.app

# Optional local admin promotion. The Better Auth user must already exist.
SEED_ADMIN_EMAIL=

# DB
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"
# FIN BLOC


# File storage
# local is intended for development/test. Production must use s3-compatible unless explicitly opted in.
FILE_STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_MB=5
ALLOW_LOCAL_FILE_STORAGE_IN_PRODUCTION=false
S3_ENDPOINT=https://s3-compatible-endpoint.example.com
S3_REGION=eu-west-3
S3_BUCKET=epion-uploads
S3_ACCESS_KEY_ID=replace_me_with_storage_access_key
S3_SECRET_ACCESS_KEY=replace_me_with_storage_secret_key
S3_PUBLIC_BASE_URL=https://cdn.example.com/epion-uploads

# AI APIs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
MISTRAL_API_KEY=
