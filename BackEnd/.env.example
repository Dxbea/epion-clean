PORT=5175
NODE_ENV=development
# APP_ENV controls deployment policy: development, test, staging, production.
# Leave empty locally; set APP_ENV=staging or APP_ENV=production on hosted environments.
APP_ENV=development

# Public frontend origin. In staging/production this must be an HTTPS public origin.
FRONTEND_ORIGIN=http://localhost:5173

# Browser origins allowed to call the API with cookies. Comma-separated origins only, no paths.
# In development/test, localhost Vite origins are also allowed automatically.
# In staging/production, every configured origin must be HTTPS and non-localhost.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF
CSRF_SECRET=replace_me_with_a_long_random_csrf_secret
ENABLE_DEBUG_ROUTES=false

# Better Auth
# In staging/production this must be the public HTTPS API origin.
BETTER_AUTH_URL=http://localhost:5175
BETTER_AUTH_SECRET=replace_me_with_a_long_random_better_auth_secret
# Optional. These origins are folded into the same browser-origin allowlist used by CORS.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Security headers / CSP
# Keep report-only while validating the beta, then switch to false once violations are clean.
CSP_REPORT_ONLY=true
CSP_REPORT_URI=
# Extra connect-src entries if the host/provider needs them, comma-separated.
CSP_EXTRA_CONNECT_SRC=

# Optional local admin promotion. The Better Auth user must already exist.
SEED_ADMIN_EMAIL=

# DB
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"

# AI APIs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
MISTRAL_API_KEY=

# Observability
SENTRY_DSN=
