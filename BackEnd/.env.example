# Epion Backend environment example
# Copy to .env for local development, then replace placeholders.

# Runtime
# NODE_ENV must stay one of: development, test, production.
# Use APP_ENV/DEPLOY_ENV to distinguish staging from production deployments.
NODE_ENV=development
APP_ENV=development
# DEPLOY_ENV=staging
PORT=5175
LOG_LEVEL=debug
BETA_MODE=false
ENABLE_DEBUG_ROUTES=false

# Database (required in every environment)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"

# Redis / BullMQ
# Required in APP_ENV=staging and APP_ENV=production. Development/test default to redis://localhost:6379 when omitted.
REDIS_URL=redis://localhost:6379

# Public frontend URL used for CORS, Better Auth trusted origins, and email links.
# FRONTEND_ORIGIN is the backend's canonical name. FRONTEND_URL is accepted as an alias.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Better Auth
# BETTER_AUTH_URL must be the public backend origin in staging/production.
BETTER_AUTH_URL=http://localhost:5175
BETTER_AUTH_SECRET=change_me_better_auth_secret_min_32_chars
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# CSRF
CSRF_SECRET=change_me_csrf_secret_min_32_chars

# AI / search providers
# Required in staging/production: OPENAI_API_KEY and SERPER_API_KEY.
OPENAI_API_KEY=
SERPER_API_KEY=

# Optional provider keys. Keep empty unless the related feature is enabled.
TAVILY_API_KEY=
GOOGLE_FACT_CHECK_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=

# Email delivery through Brevo
# Required in staging/production because auth email verification/reset depends on email.
BREVO_API_KEY=
MAIL_FROM="Epion <no-reply@epion.app>"

# Observability
# Optional. When empty, Sentry is disabled.
SENTRY_DSN=

# Optional local admin promotion. The Better Auth user must already exist.
SEED_ADMIN_EMAIL=
