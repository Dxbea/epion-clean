# DEBUT BLOC (remplace tout ce qui est entre ce commentaire et "FIN BLOC")
PORT=5175
NODE_ENV=development

# Frontend autorisé par CORS (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Origines CORS supplémentaires autorisées par le middleware Express cors()
# Format : virgule-séparé, sans espaces, URLs complètes sans chemin ni slash final
# ⚠️  Distincte de BETTER_AUTH_TRUSTED_ORIGINS (qui ne contrôle que Better Auth, pas CORS Express)
# Ajouter https://localhost pour l'app Android Capacitor (androidScheme: https)
CORS_EXTRA_ORIGINS=https://localhost

# CSRF
CSRF_SECRET=replace_me_with_a_long_random_csrf_secret
ENABLE_DEBUG_ROUTES=false


# Better Auth
BETTER_AUTH_URL=http://localhost:5175
BETTER_AUTH_SECRET=replace_me_with_a_long_random_better_auth_secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,https://epion.app,https://www.epion.app,https://localhost


# Optional local admin promotion. The Better Auth user must already exist.
SEED_ADMIN_EMAIL=

# DB
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"

# Automatic newsroom discovery (safe defaults: fully disabled)
DISCOVERY_ENABLED=false
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_KILL_SWITCH=true
DISCOVERY_WORKER_CONCURRENCY=1
DISCOVERY_SCHEDULER_POLL_MS=60000
DISCOVERY_SCHEDULER_LOCK_TTL_MS=55000
DISCOVERY_SOURCE_LOCK_TTL_MS=900000
# FIN BLOC

# AI APIs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
MISTRAL_API_KEY=
