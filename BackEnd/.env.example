# DEBUT BLOC (remplace tout ce qui est entre ce commentaire et "FIN BLOC")
PORT=5175
NODE_ENV=development

# Frontend autorisé par CORS (Vite)
FRONTEND_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace_me_with_a_long_random_secret
COOKIE_NAME=epion_session
BCRYPT_ROUNDS=12
ENABLE_DEBUG_ROUTES=false

# Better Auth (phase 1 foundation)
BETTER_AUTH_URL=http://localhost:5175
BETTER_AUTH_SECRET=replace_me_with_a_long_random_better_auth_secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,https://epion.app,https://www.epion.app

# Optional local seed admin. Leave unset to seed a non-login seed author.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# DEBUT BLOC (remplace tout ce qui est entre ce commentaire et "FIN BLOC")
RESET_TOKEN_TTL_MIN=60
FRONTEND_RESET_URL=http://localhost:5173/reset
# FIN BLOC

# DB
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"
# FIN BLOC

# AI APIs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
