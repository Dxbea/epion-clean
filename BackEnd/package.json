{
  "name": "epion-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" --names \"API,WORKER\" -c \"blue,magenta\"",
    "dev:server": "npm run dev:api",
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:api",
    "db:studio": "prisma studio",
    "db:gen": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "worker:embedding": "node --import ./dist/instrument.js dist/workers/embedding.worker.js",
    "worker:source-enrichment": "node --import ./dist/instrument.js dist/workers/source-enrichment.worker.js",
    "worker:news": "node --import ./dist/instrument.js dist/workers/news-worker.js",
    "worker:discovery": "node --import ./dist/instrument.js dist/workers/discovery.worker.js",
    "worker:document-corpus": "node --import ./dist/instrument.js dist/workers/document-corpus.worker.js",
    "worker:editorial-shadow": "node --import ./dist/instrument.js dist/workers/editorial-shadow.worker.js",
    "worker:editorial-brief": "node --import ./dist/instrument.js dist/workers/editorial-brief.worker.js",
    "worker:editorial-draft": "node --import ./dist/instrument.js dist/workers/editorial-draft.worker.js",
    "worker:editorial-verification": "node --import ./dist/instrument.js dist/workers/editorial-verification.worker.js",
    "worker:editorial-automation": "node --import ./dist/instrument.js dist/workers/editorial-automation.worker.js",
    "editorial:automation:once": "node --import ./dist/instrument.js dist/scripts/editorial-automation-once.js",
    "editorial:automation:readiness": "node --import ./dist/instrument.js dist/scripts/editorial-automation-readiness.js",
    "editorial:automation:publish-once": "node --import ./dist/instrument.js dist/scripts/editorial-automation-publish-once.js",
    "editorial:automation:smoke": "node --import ./dist/instrument.js dist/scripts/editorial-publication-smoke.js",
    "editorial:automation:sources": "node --import ./dist/instrument.js dist/scripts/list-editorial-automation-sources.js",
    "staging:editorial:migrations": "node --import tsx src/scripts/audit-editorial-migrations.ts",
    "staging:editorial:readiness": "node --import tsx src/scripts/editorial-staging-readiness.ts",
    "staging:editorial:seed": "node --import tsx src/scripts/seed-editorial-staging.ts",
    "staging:editorial:e2e": "node --import tsx src/scripts/editorial-staging-e2e.ts",
    "prod-shadow:editorial:readiness": "node --import ./dist/instrument.js dist/scripts/prod-shadow-editorial-readiness.js",
    "prod-shadow:editorial:seed": "node --import ./dist/instrument.js dist/scripts/seed-prod-shadow-editorial.js",
    "prod-shadow:editorial:e2e": "node --import ./dist/instrument.js dist/scripts/prod-shadow-editorial-e2e.js",
    "test": "vitest --run",
    "dev:api": "tsx --import ./src/instrument.ts src/server.ts",
    "dev:worker": "tsx --import ./src/instrument.ts src/workers/index.ts",
    "start:api": "node --import ./dist/instrument.js dist/server.js",
    "start:worker": "node --import ./dist/instrument.js dist/workers/index.js",
    "worker:live-analysis": "node --import ./dist/instrument.js dist/workers/live-analysis.worker.js",
    "backfill:article-sources:dry-run": "node --import tsx src/scripts/backfill-article-sources.ts --dry-run",
    "backfill:article-sources:write": "node --import tsx src/scripts/backfill-article-sources.ts --write",
    "refresh:source-profiles:report-only": "node --import tsx src/scripts/refresh-source-profiles.ts --report-only",
    "refresh:source-profiles:dry-run": "node --import tsx src/scripts/refresh-source-profiles.ts --dry-run",
    "refresh:source-profiles:write": "node --import tsx src/scripts/refresh-source-profiles.ts --write",
    "report:source-pipeline": "node --import tsx src/scripts/report-source-pipeline.ts",
    "discovery:dry-run": "node --import tsx src/scripts/discovery-dry-run.ts",
    "audit:rss-institutional": "node --import ./dist/instrument.js dist/scripts/audit-rss-institutional-sources.js --write",
    "audit:rss-institutional:check": "node --import ./dist/instrument.js dist/scripts/audit-rss-institutional-sources.js",
    "seed:rss-institutional": "node --import ./dist/instrument.js dist/scripts/seed-institutional-rss-sources.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.893.0",
    "@aws-sdk/client-sso": "^3.893.0",
    "@mistralai/mistralai": "^2.2.5",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6.14.0",
    "@sentry/node": "^10.58.0",
    "@sentry/profiling-node": "^10.58.0",
    "@tavily/core": "^0.7.2",
    "@types/cheerio": "^0.22.35",
    "@types/jsdom": "^27.0.0",
    "axios": "^1.18.0",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.18",
    "bullmq": "^5.67.0",
    "cheerio": "^1.2.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.5.7",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "node-curl-impersonate": "^1.0.2",
    "nodemailer": "^9.0.1",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "react-markdown": "^10.1.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.7",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^10.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.7"
  }
}
