// BackEnd/prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // .env doit contenir : DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  READER
  PREMIUM
}

enum OrganizationRole {
  MEMBER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FactCheckStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STALE
}

enum ArticleSourceRole {
  PRIMARY_EVIDENCE
  CONTEXT
  COUNTERPOINT
  OFFICIAL_STATEMENT
  BACKGROUND
  UNKNOWN
}

enum ArticleSourceSupportStrength {
  STRONG
  MODERATE
  WEAK
  UNKNOWN
}

enum ArticleSourceProvenance {
  WEB_SEARCH
  INTERNAL_RAG
  USER_PROVIDED
  EDITORIAL
  IMPORTED_LEGACY
  UNKNOWN
}

enum DiscoveryConnectorType {
  RSS
  ATOM
  SITEMAP
  SITEMAP_INDEX
  GDELT
  GOOGLE_NEWS_RSS
  OFFICIAL_API
  HTML_LISTING
  MANUAL
}

enum DiscoveryAccessPolicy {
  FEED_ONLY
  ROBOTS_ALLOWED
  EXPLICIT_ALLOWLIST
  OFFICIAL_API
  LICENSED
  METADATA_ONLY
  BLOCKED
}

enum DiscoveryContentStoragePolicy {
  FULL_TEXT
  EXCERPT_ONLY
  METADATA_ONLY
  TRANSIENT
  NONE
}

enum IngestedDocumentStatus {
  DISCOVERED
  FETCH_PENDING
  FETCHED
  EXTRACTED
  INDEXED
  PARTIAL
  BLOCKED
  FAILED
}

enum EditorialRunMode {
  SHADOW
}

enum EditorialRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum EditorialCandidateStatus {
  SHADOW_PROPOSED
  SHADOW_SUPPRESSED
}

enum EditorialRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum EditorialTopicDocumentRole {
  REPRESENTATIVE
  EVIDENCE
  QUASI_DUPLICATE
}

enum EditorialDossierStatus {
  PENDING
  RUNNING
  EVIDENCE_READY
  COMPLETED
  BLOCKED
  FAILED
}

enum EditorialEvidenceRole {
  PRIMARY
  CONTEXT
}

enum EditorialDraftStatus {
  PENDING
  GENERATING
  READY_FOR_REVIEW
  QUALITY_FAILED
  HUMAN_REJECTED
  ARTICLE_DRAFT_CREATED
  FAILED
}

enum EditorialClaimImportance {
  CORE
  SUPPORTING
  CONTEXT
}

enum EditorialClaimVerdict {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  CONTRADICTED
}

enum EditorialGateDecision {
  PASSED
  FAILED
}

enum EditorialHumanReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(USER)
  emailVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  username     String?  @unique
  phone        String?
  avatarUrl    String?
  bannerUrl    String?

  articles    Article[]         @relation("AuthorArticles")
  saved       SavedArticle[]
  messages    ChatMessage[]
  sessions    ChatSession[]
  betterAuthSessions BetterAuthSession[]
  betterAuthAccounts BetterAuthAccount[]
  comments    Comment[]         @relation("UserComments")
  reactions   ArticleReaction[] @relation("UserReactions")
  opinionPositions ArticleOpinionPosition[] @relation("UserArticleOpinionPositions")
  contributions    ArticleContribution[]    @relation("UserArticleContributions")
  contributionValidations ArticleContributionValidation[] @relation("UserArticleContributionValidations")
  contributionReports ArticleContributionReport[] @relation("UserArticleContributionReports")
  reviewedContributionReports ArticleContributionReport[] @relation("UserReviewedArticleContributionReports")
  editorialGateReviews EditorialQualityGate[] @relation("EditorialQualityGateReviewer")
  ArticleView ArticleView[]
  ChatFolder  ChatFolder[]

  subscriptionTier SubscriptionTier @default(FREE)
  dailyQueryCount  Int              @default(0) // Reset à minuit
  creditsArticle   Int              @default(0) // Pour le Premium

  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  organizationRole OrganizationRole?

  // Social
  bio            String?
  isPublic       Boolean     @default(false)
  reposts        Repost[]
  followers      Follow[]    @relation("UserFollowers")
  following      Follow[]    @relation("UserFollowing")
  followersCount Int         @default(0)
  followingCount Int         @default(0)

  usage UserUsage?

  // Beta invite
  inviteCodeId String?
  inviteCode   InviteCode? @relation("UserInvite", fields: [inviteCodeId], references: [id])
}

enum PlanType {
  FREE
  READER
  PREMIUM
}

model UserUsage {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Epion Energy System
  dailyCredits        Int      @default(700)
  lastResetAt         DateTime @default(now())
  
  // Weekly Article Quota
  articlesCreated     Int      @default(0)
  articleQuotaResetAt DateTime @default(now())
  
  plan                PlanType @default(FREE)
}

// -----------------------------------------------------------------------------
model IpUsage {
  ipAddress      String   @id
  messageCount   Int      @default(0)
  lastMessageAt  DateTime @default(now())
}


model Repost {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([articleId])
  @@unique([userId, articleId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String? // pour auto-join
  createdAt DateTime @default(now())

  members User[]
}

model BetterAuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BetterAuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model BetterAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles         Article[]
  discoverySources DiscoverySource[]
}

// ---------------- Article ----------------
model Article {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String?
  content   String?
  structuredContent Json?
  status    ArticleStatus @default(DRAFT)
  imageUrl  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  authorId String?
  author   User?   @relation("AuthorArticles", fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  savedBy SavedArticle[]

  // (déjà présents si tu as les vues/stats)
  views ArticleView[] @relation("ArticleViews")
  stats ArticleStats? @relation("ArticleStats")

  // IA
  generationPrompt  String?
  generationConfig  Json?
  generatedAt       DateTime?
  generationVersion Int       @default(0)
  aiLockedFields    Json? // ex: ["title", "summary", "content"]

  // IA Results Persistence
  aiSummary            String?          @db.Text
  factCheckScore       Int?
  factCheckData        Json?            // Stores full JSON analysis (v1: ArticleScorePayload)
  factCheckStatus      FactCheckStatus? // Lifecycle: PENDING → RUNNING → COMPLETED | FAILED | STALE
  factCheckContentHash String?          // SHA-256 of analysis input for invalidation detection
  factCheckStartedAt   DateTime?
  factCheckCompletedAt DateTime?
  factCheckError       String?          // Error message if status=FAILED

  // 🔥 Add these two back-relations:
  comments  Comment[]         @relation("ArticleComments")
  reactions ArticleReaction[] @relation("ArticleReactions")
  reposts   Repost[]
  opinionQuestion  ArticleOpinionQuestion?
  opinionPositions ArticleOpinionPosition[]
  contributions    ArticleContribution[]
  articleSources   ArticleSource[]

  // RAG / Indexing
  isIndexed       Boolean         @default(false)

  chunks          KnowledgeChunk[]
  editorialDraft  EditorialDraft?

  @@index([authorId])
  @@index([categoryId])
  @@index([status, createdAt])
}

model SavedArticle {
  userId    String
  articleId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

// prisma/schema.prisma
model ArticleView {
  id        String  @id @default(cuid())
  articleId String
  // ✅ le nom "ArticleViews" doit matcher celui côté Article
  article   Article @relation("ArticleViews", fields: [articleId], references: [id], onDelete: Cascade)

  userId String?
  // (une seule relation User<->ArticleView, donc pas besoin de nom ici)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  viewerHash String? // hash(IP + UA) pour anonymes
  createdAt  DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([articleId, userId, createdAt])
  @@index([articleId, viewerHash, createdAt])
}

model ArticleStats {
  articleId String  @unique
  // ✅ le nom "ArticleStats" doit matcher celui côté Article
  article   Article @relation("ArticleStats", fields: [articleId], references: [id], onDelete: Cascade)

  viewsAll      Int       @default(0)
  views7d       Int       @default(0)
  views30d      Int       @default(0)
  savesAll      Int       @default(0)
  trendingScore Float     @default(0)
  lastViewedAt  DateTime?
  updatedAt     DateTime  @updatedAt
}

// ---------------- Enums ----------------
enum ReactionType {
  LIKE
  DISLIKE
  CLAP
  HEART
  FIRE
  THINK
}

enum ArticleContributionType {
  SOURCE
  NUANCE
  CONTRADICTION
  QUESTION
  CORRECTION
}

enum ArticleContributionValidationType {
  WELL_SOURCED
  ADDS_NUANCE
  NEEDS_CHECK
}

enum ArticleContributionStatus {
  ACTIVE
  DELETED
  HIDDEN
  STALE
}

enum ArticleContributionReportReason {
  SPAM
  ABUSE
  OFF_TOPIC
  MISLEADING_SOURCE
  PERSONAL_DATA
  OTHER
}

enum ArticleContributionReportStatus {
  PENDING
  DISMISSED
  REVIEWED
  ACTIONED
}

model ArticleOpinionQuestion {
  id        String   @id @default(cuid())
  articleId String   @unique
  question  String
  thesisA   String
  thesisB   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleOpinionPosition {
  id               String    @id @default(cuid())
  articleId        String
  userId           String
  selectedPosition Float?
  lacksContext     Boolean   @default(false)
  confirmedAt      DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation("UserArticleOpinionPositions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
}

model ArticleContribution {
  id                   String                  @id @default(cuid())
  articleId            String
  userId               String?
  targetContributionId String?
  type                 ArticleContributionType
  status               ArticleContributionStatus @default(ACTIVE)
  text                 String
  sourceUrl            String?
  needsRecalc          Boolean                 @default(false)
  bridgingScore        Float                   @default(0)
  deletedAt            DateTime?
  editedAt             DateTime?
  editCount            Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  article            Article                         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user               User?                           @relation("UserArticleContributions", fields: [userId], references: [id], onDelete: SetNull)
  targetContribution ArticleContribution?             @relation("ArticleContributionNotes", fields: [targetContributionId], references: [id], onDelete: Cascade)
  children           ArticleContribution[]            @relation("ArticleContributionNotes")
  validations        ArticleContributionValidation[]
  reports            ArticleContributionReport[]

  @@index([articleId, bridgingScore(sort: Desc), createdAt(sort: Desc)])
  @@index([articleId, createdAt])
  @@index([articleId, status, createdAt])
  @@index([targetContributionId, bridgingScore(sort: Desc), createdAt(sort: Desc)])
  @@index([needsRecalc])
  @@index([userId])
}

model ArticleContributionValidation {
  id             String                            @id @default(cuid())
  contributionId String
  userId         String
  type           ArticleContributionValidationType
  createdAt      DateTime                          @default(now())

  contribution ArticleContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User                @relation("UserArticleContributionValidations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contributionId, userId, type])
  @@index([userId])
}

model ArticleContributionReport {
  id             String                           @id @default(cuid())
  contributionId String
  reporterId     String?
  reason         ArticleContributionReportReason
  details        String?
  status         ArticleContributionReportStatus @default(PENDING)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  reviewedAt     DateTime?
  reviewedById   String?

  contribution ArticleContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reporter     User?               @relation("UserArticleContributionReports", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy   User?               @relation("UserReviewedArticleContributionReports", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([contributionId, reporterId, reason])
  @@index([status, createdAt])
  @@index([reporterId])
  @@index([reviewedById])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  userId    String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Threads
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Relations
  article Article @relation("ArticleComments", fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserComments", fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// ---------------- Reaction ----------------
model ArticleReaction {
  userId    String
  articleId String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  // Relations
  user    User    @relation("UserReactions", fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation("ArticleReactions", fields: [articleId], references: [id], onDelete: Cascade)

  // One reaction per (user, article) - Strict uniqueness
  @@id([userId, articleId])
  @@index([articleId])
}

// --- Enums (keep only one copy) ---
enum ChatRole {
  user
  assistant
}

enum Rigor {
  fast
  balanced
  precise
}

// --- Models ---

model ChatFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ChatSession[]

  @@unique([userId, name])
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic    String?
  mode     Rigor   @default(balanced) // rigor level persisted
  folderId String? // optional folder

  folder   ChatFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([folderId])
}

model ChatMessage {
  id String @id @default(cuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String? // null for assistant
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  role     ChatRole
  content  String
  sources  Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId, createdAt]) // ⬅️ ajouté pour le count { where: { userId } }
}

model Source {
  id          String   @id @default(uuid())
  domain      String   @unique  // ex: "lemonde.fr"
  name        String            // ex: "Le Monde"
  
  // --- SCORE FINAL ---
  trustScore  Int      @default(50) // Le résultat calculé (0-100)
  
  // --- PILIER 1 : TRANSPARENCE (Structurel) ---
  transparencyScore Int @default(0)
  isAdsTxtValid     Boolean @default(false) // ads.txt présent et valide
  isOwnerPublic     Boolean @default(false) // Propriétaire identifié (JTI)
  
  // --- PILIER 2 : PROCESSUS (Éditorial) ---
  editorialScore    Int @default(0)
  hasFactCheckFailures Boolean @default(false) // "Kill Switch" potentiel
  factCheckFailCount   Int     @default(0)     // Nombre d'erreurs répertoriées
  hasCorrectionPolicy  Boolean @default(false) // Politique de correction visible
  
  // --- PILIER 3 : SÉMANTIQUE (Contenu) ---
  semanticScore     Int @default(0)
  // biasLevel REMOVED in favor of 2-Axis System
  politicalBias     PoliticalBias @default(UNKNOWN)
  biasScore         Int           @default(0) // -100 (Left) to +100 (Right)
  reliability       Reliability   @default(UNKNOWN)
  detectedCountry   String?       @default("FR")
  
  isClickbait       Boolean @default(false)     // REMOVED: Article-specific
  
  // --- PILIER 4 : PLURALISME (Diversité des points de vue) ---
  pluralismScore    Int      @default(0)
  pluralismDetails  Json?    // { pivots: number, entities: number, controversy: number }
  // uxScore REMOVED
  
  // --- INFOS GÉNÉRALES ---
  type            String   @default("GENERAL")
  justification   String?  // Explication humaine ("Pourquoi ce score ?")
  description     String?  // Bio générée par IA
  metadata        Json?    // Métadonnées étendues (ex: owners, headquarters...)
  auditCount      Int      @default(0) // Nombre d'audits réalisés (pour la moyenne cumulative)
  lastAuditDate   DateTime?
  profileData        Json?
  profileVersion     Int?
  profileConfidence  ConfidenceLevel?
  lastProfiledAt     DateTime?
  publicTrustLabel   String?
  
  // --- EXTENSION CONSENSUS PROTOCOL ---
  // Données brutes pour la transparence
  mbfcRating       String?   // ex: "Left-Center", "Right"
  allSidesRating   String?   // ex: "Lean Left", "Center"
  adFontesScore    Float?    // Score numérique

  // Flag de validation humaine/consensus
  isConsensusVerified Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  articleSources    ArticleSource[]
  discoverySources  DiscoverySource[]
  ingestedDocuments IngestedDocument[]
}

model ArticleSource {
  id String @id @default(cuid())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  sourceUrl     String
  sourceUrlHash String

  role            ArticleSourceRole            @default(UNKNOWN)
  supportStrength ArticleSourceSupportStrength @default(UNKNOWN)
  provenance      ArticleSourceProvenance      @default(UNKNOWN)

  profileSnapshot Json?
  profileVersion  Int?
  snapshotAt      DateTime?
  position        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, sourceUrlHash])
  @@index([articleId, position])
  @@index([sourceId])
  @@index([articleId, role])
}

// -----------------------------------------------------------------------------
// EDITORIAL DISCOVERY CORPUS
// -----------------------------------------------------------------------------
model DiscoverySource {
  id            String                 @id @default(cuid())
  key           String                 @unique
  name          String
  connectorType DiscoveryConnectorType
  endpoint      String
  enabled       Boolean                @default(false)
  priority      Int                    @default(0)

  language String?
  country  String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  schedule         String?
  maxItemsPerRun   Int     @default(100)
  requestTimeoutMs Int     @default(20000)
  rateLimitPerHour Int?
  configuration    Json?

  cursor        String?
  etag          String?
  lastModified  String?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastSuccessAt DateTime?

  consecutiveFailures Int     @default(0)
  disabledReason      String?

  accessPolicy  DiscoveryAccessPolicy         @default(METADATA_ONLY)
  storagePolicy DiscoveryContentStoragePolicy @default(METADATA_ONLY)
  licenseNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discoveries DocumentDiscovery[]

  @@index([enabled, nextRunAt])
  @@index([connectorType, endpoint])
  @@index([categoryId])
  @@index([sourceId])
}

model IngestedDocument {
  id                      String  @id @default(cuid())
  url                     String
  canonicalUrl            String
  canonicalUrlHash        String  @unique
  canonicalizationVersion Int     @default(1)
  domain                  String
  title                   String?
  snippet                 String? @db.Text
  content                 String? @db.Text
  contentHash             String?
  language                String?

  duplicateOfId String?
  duplicateOf   IngestedDocument?  @relation("IngestedDocumentDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    IngestedDocument[] @relation("IngestedDocumentDuplicates")

  publishedAt       DateTime?
  sourceUpdatedAt   DateTime?
  discoveredAt      DateTime  @default(now())
  fetchedAt         DateTime?
  lastFetchAttemptAt DateTime?
  fetchAttempts      Int       @default(0)
  fetchError         String?

  status           IngestedDocumentStatus        @default(DISCOVERED)
  extractionMethod String?
  accessPolicy     DiscoveryAccessPolicy         @default(METADATA_ONLY)
  storagePolicy    DiscoveryContentStoragePolicy @default(METADATA_ONLY)
  robotsAllowed    Boolean?
  robotsCheckedAt  DateTime?
  licenseDecision  String?

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  isIndexed           Boolean   @default(false)
  indexedAt           DateTime?
  embeddingModel      String?
  chunkingVersion     Int?
  embeddingTokenCount Int?
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discoveries                    DocumentDiscovery[]
  chunks                         DocumentChunk[]
  canonicalContentIdentities     DocumentContentIdentity[] @relation("CanonicalDocumentContentIdentity")
  editorialTopicDocuments        EditorialTopicDocument[]  @relation("EditorialTopicEvidenceDocument")
  representedEditorialTopics     EditorialTopic[]          @relation("EditorialTopicRepresentative")
  editorialQuasiDuplicateTargets EditorialTopicDocument[] @relation("EditorialTopicQuasiDuplicate")
  editorialBriefEvidence         EditorialBriefEvidence[]

  @@index([domain, publishedAt])
  @@index([sourceId, publishedAt])
  @@index([status, discoveredAt])
  @@index([contentHash])
  @@index([duplicateOfId])
}

model DocumentContentIdentity {
  contentHash         String           @id
  canonicalDocumentId String
  canonicalDocument   IngestedDocument @relation("CanonicalDocumentContentIdentity", fields: [canonicalDocumentId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())

  @@index([canonicalDocumentId])
}

model DocumentChunk {
  id              String                        @id @default(uuid())
  documentId      String
  document        IngestedDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position        Int
  content         String                        @db.Text
  contentHash     String
  estimatedTokens Int
  embedding       Unsupported("vector(1536)")?
  embeddingModel  String
  chunkingVersion Int
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  editorialBriefEvidence EditorialBriefEvidence[]

  @@unique([documentId, position])
  @@index([documentId])
  @@index([contentHash])
}

model DocumentDiscovery {
  id String @id @default(cuid())

  documentId String
  document   IngestedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  discoverySourceId String
  discoverySource   DiscoverySource @relation(fields: [discoverySourceId], references: [id], onDelete: Restrict)

  externalId            String?
  discoveredUrl         String
  discoveredUrlHash     String
  canonicalHint         String?
  canonicalHintAccepted Boolean  @default(false)
  discoveredAt          DateTime @default(now())
  lastSeenAt            DateTime @default(now())
  seenCount             Int      @default(1)
  metadata              Json?

  @@unique([discoverySourceId, discoveredUrlHash])
  @@unique([discoverySourceId, externalId])
  @@index([documentId, discoveredAt])
  @@index([discoverySourceId, discoveredAt])
  @@index([discoverySourceId, lastSeenAt])
}

model EditorialRun {
  id               String             @id @default(cuid())
  idempotencyKey   String             @unique
  mode             EditorialRunMode   @default(SHADOW)
  status           EditorialRunStatus @default(PENDING)
  windowStart      DateTime
  windowEnd        DateTime
  algorithmVersion String
  embeddingModel   String
  configuration    Json?
  startedAt        DateTime?
  completedAt      DateTime?
  leaseExpiresAt   DateTime?
  attempts         Int                @default(0)
  error            String?
  metrics          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  topics EditorialTopic[]

  @@index([status, createdAt])
  @@index([windowStart, windowEnd])
}

model EditorialTopic {
  id                       String                         @id @default(cuid())
  runId                    String
  run                      EditorialRun                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterKey               String
  label                    String
  language                 String?
  dominantCategoryId       String?
  dominantSourceId         String?
  representativeDocumentId String
  representativeDocument   IngestedDocument               @relation("EditorialTopicRepresentative", fields: [representativeDocumentId], references: [id], onDelete: Restrict)
  centroidEmbedding        Unsupported("vector(1536)")?
  centroidModel            String
  documentCount            Int
  independentDomainCount   Int
  firstEventAt             DateTime
  latestEventAt            DateTime
  metadata                 Json?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  documents EditorialTopicDocument[]
  candidate EditorialCandidate?

  @@unique([runId, clusterKey])
  @@index([runId, latestEventAt])
  @@index([representativeDocumentId])
  @@index([dominantCategoryId, latestEventAt])
}

model EditorialTopicDocument {
  id                         String                     @id @default(cuid())
  topicId                    String
  topic                      EditorialTopic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  documentId                 String
  document                   IngestedDocument           @relation("EditorialTopicEvidenceDocument", fields: [documentId], references: [id], onDelete: Restrict)
  role                       EditorialTopicDocumentRole
  similarityToCentroid       Float
  quasiDuplicateOfDocumentId String?
  quasiDuplicateOfDocument   IngestedDocument?          @relation("EditorialTopicQuasiDuplicate", fields: [quasiDuplicateOfDocumentId], references: [id], onDelete: Restrict)
  eventAt                    DateTime
  createdAt                  DateTime                   @default(now())

  @@unique([topicId, documentId])
  @@index([documentId])
  @@index([quasiDuplicateOfDocumentId])
  @@index([topicId, role])
}

model EditorialCandidate {
  id                     String                   @id @default(cuid())
  topicId                String                   @unique
  topic                  EditorialTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status                 EditorialCandidateStatus
  editorialScore         Float
  freshnessScore         Float
  sourceDiversityScore   Float
  independentDomainScore Float
  coverageScore          Float
  relevanceScore         Float
  riskScore              Float
  riskLevel              EditorialRiskLevel
  shadowOnly             Boolean                  @default(true)
  rationale              Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  sourceDossiers EditorialSourceDossier[]

  @@index([status, editorialScore])
  @@index([riskLevel, editorialScore])
}

model EditorialSourceDossier {
  id                    String                  @id @default(cuid())
  candidateId           String
  candidate             EditorialCandidate      @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  idempotencyKey        String                  @unique
  dossierVersion        String
  status                EditorialDossierStatus @default(PENDING)
  shadowOnly            Boolean                 @default(true)
  generatorModel        String
  promptVersion         String
  selectionRank         Int
  minimumDomains        Int
  maxDocuments          Int
  maxChunksPerDocument  Int
  configuration         Json?
  candidateSnapshot     Json?
  sourceDomains         Json?
  evidenceHash          String?
  evidenceFrozenAt      DateTime?
  selectedDocumentCount Int                     @default(0)
  selectedDomainCount   Int                     @default(0)
  selectedChunkCount    Int                     @default(0)
  attempts              Int                     @default(0)
  leaseExpiresAt        DateTime?
  error                 String?
  metrics               Json?
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  evidence EditorialBriefEvidence[]
  brief    EditorialBrief?

  @@index([candidateId, createdAt])
  @@index([status, createdAt])
}

model EditorialBriefEvidence {
  id               String                  @id @default(cuid())
  dossierId        String
  dossier          EditorialSourceDossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  documentId       String
  document         IngestedDocument        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  chunkId          String
  chunk             DocumentChunk           @relation(fields: [chunkId], references: [id], onDelete: Restrict)
  evidenceKey      String
  role             EditorialEvidenceRole
  position         Int
  similarity       Float
  documentTitle    String
  canonicalUrl     String
  domain           String
  publishedAt      DateTime?
  chunkPosition    Int
  contentSnapshot  String                  @db.Text
  contentHash      String
  createdAt        DateTime                @default(now())

  draftClaimEvidence EditorialDraftClaimEvidence[]

  @@unique([dossierId, chunkId])
  @@unique([dossierId, evidenceKey])
  @@index([documentId])
  @@index([chunkId])
  @@index([dossierId, role, position])
}

model EditorialBrief {
  id                  String                 @id @default(cuid())
  dossierId           String                 @unique
  dossier             EditorialSourceDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  schemaVersion       Int                    @default(1)
  promptVersion       String
  generatorModel      String
  structuredContent   Json
  contentHash         String
  inputTokens         Int?
  outputTokens        Int?
  estimatedCostMicros Int?
  shadowOnly          Boolean                @default(true)
  generatedAt         DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  drafts EditorialDraft[]

  @@index([contentHash])
  @@index([generatedAt])
}

model EditorialDraft {
  id                    String               @id @default(cuid())
  briefId               String
  brief                 EditorialBrief       @relation(fields: [briefId], references: [id], onDelete: Restrict)
  idempotencyKey        String               @unique
  draftVersion          String
  promptVersion         String
  generatorModel        String
  criticModel           String
  status                EditorialDraftStatus @default(PENDING)
  title                 String?
  summary               String?              @db.Text
  contentHtml           String?              @db.Text
  structuredContent     Json?
  contentHash           String?
  briefContentHash      String
  evidenceHash          String
  configuration         Json?
  attempts              Int                  @default(0)
  leaseExpiresAt        DateTime?
  error                 String?
  metrics               Json?
  generatedAt           DateTime?
  completedAt           DateTime?
  articleId             String?              @unique
  article               Article?             @relation(fields: [articleId], references: [id], onDelete: Restrict)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  claims      EditorialDraftClaim[]
  qualityGate EditorialQualityGate?

  @@index([briefId, createdAt])
  @@index([status, createdAt])
}

model EditorialDraftClaim {
  id                    String                     @id @default(cuid())
  draftId               String
  draft                 EditorialDraft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  claimKey              String
  position              Int
  text                  String                     @db.Text
  importance            EditorialClaimImportance
  evidenceKeys          Json
  citedDocumentIds      Json
  citedChunkIds         Json
  citedDomains          Json
  verdict               EditorialClaimVerdict
  criticExplanation     String                     @db.Text
  criticEvidenceKeys    Json
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  evidence EditorialDraftClaimEvidence[]

  @@unique([draftId, claimKey])
  @@index([draftId, verdict, importance])
}

model EditorialDraftClaimEvidence {
  id               String                 @id @default(cuid())
  claimId          String
  claim            EditorialDraftClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  briefEvidenceId  String
  briefEvidence    EditorialBriefEvidence @relation(fields: [briefEvidenceId], references: [id], onDelete: Restrict)
  citationOrder    Int
  criticConfirmed  Boolean                @default(false)
  createdAt        DateTime               @default(now())

  @@unique([claimId, briefEvidenceId])
  @@index([briefEvidenceId])
  @@index([claimId, citationOrder])
}

model EditorialQualityGate {
  id                    String                     @id @default(cuid())
  draftId               String                     @unique
  draft                 EditorialDraft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  gateVersion           String
  qualityScore          Float
  publishabilityScore   Float
  citationCoverage      Float
  supportedClaimRatio   Float
  coreClaimSupportRatio Float
  independentDomains    Int
  automatedDecision     EditorialGateDecision
  automatedReasons      Json
  thresholds            Json
  humanReviewStatus     EditorialHumanReviewStatus @default(PENDING)
  reviewedById          String?
  reviewedBy            User?                      @relation("EditorialQualityGateReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNote            String?                    @db.Text
  reviewedAt            DateTime?
  articleCreatedAt      DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([automatedDecision, humanReviewStatus, createdAt])
  @@index([reviewedById, reviewedAt])
}

enum PoliticalBias {
  EXTREME_LEFT
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  EXTREME_RIGHT
  SATIRE
  UNKNOWN
}

enum Reliability {
  HIGH
  MIXED
  LOW
  PROPAGANDA
  UNKNOWN
}

enum ConfidenceLevel {
  LOW     // IA ou Import auto (Incertain)
  MEDIUM  // Vérifié historiquement
  HIGH    // Audité et Certifié par Epion
}

enum SourceType {
  AGENCY
  MEDIA
  ACADEMIC
  GOVERNMENT
  BLOG
  SOCIAL
  COMMERCIAL
  GENERAL
}

enum SourceBias {
  FAR_LEFT
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  FAR_RIGHT
  SATIRE
  UNKNOWN
}

// -----------------------------------------------------------------------------
// RAG: KNOWLEDGE CHUNKS
// -----------------------------------------------------------------------------
model KnowledgeChunk {
  id        String                 @id @default(uuid())
  content   String
  embedding Unsupported("vector(1536)")?
  articleId String
  article   Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // TODO: Fix Hnsw index syntax. Currently causing validation error P1012.
  // @@index([embedding], name: "embedding_index", type: Hnsw)
}

// -----------------------------------------------------------------------------
// BETA INVITE CODES
// -----------------------------------------------------------------------------
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(100)
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  users     User[]    @relation("UserInvite")
}

// -----------------------------------------------------------------------------
// NEWS CACHE
// -----------------------------------------------------------------------------
model NewsCache {
  id          String   @id @default(cuid())
  url         String   @unique
  domain      String
  title       String
  content     String   // Markdown extrait par Jina
  publishedAt DateTime
  createdAt   DateTime @default(now())
  // Les vecteurs et MinHash seront gérés en SQL pur
}
