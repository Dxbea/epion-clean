// BackEnd/prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // .env doit contenir : DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epion?schema=public"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  READER
  PREMIUM
}

enum OrganizationRole {
  MEMBER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FactCheckStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STALE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(USER)
  emailVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  username     String?  @unique
  phone        String?
  avatarUrl    String?
  bannerUrl    String?

  articles    Article[]         @relation("AuthorArticles")
  saved       SavedArticle[]
  messages    ChatMessage[]
  sessions    ChatSession[]
  betterAuthSessions BetterAuthSession[]
  betterAuthAccounts BetterAuthAccount[]
  comments    Comment[]         @relation("UserComments")
  reactions   ArticleReaction[] @relation("UserReactions")
  opinionPositions ArticleOpinionPosition[] @relation("UserArticleOpinionPositions")
  contributions    ArticleContribution[]    @relation("UserArticleContributions")
  contributionValidations ArticleContributionValidation[] @relation("UserArticleContributionValidations")
  ArticleView ArticleView[]
  ChatFolder  ChatFolder[]

  subscriptionTier SubscriptionTier @default(FREE)
  dailyQueryCount  Int              @default(0) // Reset à minuit
  creditsArticle   Int              @default(0) // Pour le Premium

  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  organizationRole OrganizationRole?

  // Social
  bio            String?
  isPublic       Boolean     @default(false)
  reposts        Repost[]
  followers      Follow[]    @relation("UserFollowers")
  following      Follow[]    @relation("UserFollowing")
  followersCount Int         @default(0)
  followingCount Int         @default(0)

  usage UserUsage?

  // Beta invite
  inviteCodeId String?
  inviteCode   InviteCode? @relation("UserInvite", fields: [inviteCodeId], references: [id])
}

enum PlanType {
  FREE
  READER
  PREMIUM
}

model UserUsage {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Epion Energy System
  dailyCredits        Int      @default(700)
  lastResetAt         DateTime @default(now())
  
  // Weekly Article Quota
  articlesCreated     Int      @default(0)
  articleQuotaResetAt DateTime @default(now())
  
  plan                PlanType @default(FREE)
}

// -----------------------------------------------------------------------------
model IpUsage {
  ipAddress      String   @id
  messageCount   Int      @default(0)
  lastMessageAt  DateTime @default(now())
}


model Repost {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([articleId])
  @@unique([userId, articleId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String? // pour auto-join
  createdAt DateTime @default(now())

  members User[]
}

model BetterAuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BetterAuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model BetterAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles Article[]
}

// ---------------- Article ----------------
model Article {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String?
  content   String?
  structuredContent Json?
  status    ArticleStatus @default(DRAFT)
  imageUrl  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  authorId String?
  author   User?   @relation("AuthorArticles", fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  savedBy SavedArticle[]

  // (déjà présents si tu as les vues/stats)
  views ArticleView[] @relation("ArticleViews")
  stats ArticleStats? @relation("ArticleStats")

  // IA
  generationPrompt  String?
  generationConfig  Json?
  generatedAt       DateTime?
  generationVersion Int       @default(0)
  aiLockedFields    Json? // ex: ["title", "summary", "content"]

  // IA Results Persistence
  aiSummary            String?          @db.Text
  factCheckScore       Int?
  factCheckData        Json?            // Stores full JSON analysis (v1: ArticleScorePayload)
  factCheckStatus      FactCheckStatus? // Lifecycle: PENDING → RUNNING → COMPLETED | FAILED | STALE
  factCheckContentHash String?          // SHA-256 of analysis input for invalidation detection
  factCheckStartedAt   DateTime?
  factCheckCompletedAt DateTime?
  factCheckError       String?          // Error message if status=FAILED

  // 🔥 Add these two back-relations:
  comments  Comment[]         @relation("ArticleComments")
  reactions ArticleReaction[] @relation("ArticleReactions")
  reposts   Repost[]
  opinionQuestion  ArticleOpinionQuestion?
  opinionPositions ArticleOpinionPosition[]
  contributions    ArticleContribution[]

  // RAG / Indexing
  isIndexed       Boolean         @default(false)

  chunks          KnowledgeChunk[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, createdAt])
}

model SavedArticle {
  userId    String
  articleId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

// prisma/schema.prisma
model ArticleView {
  id        String  @id @default(cuid())
  articleId String
  // ✅ le nom "ArticleViews" doit matcher celui côté Article
  article   Article @relation("ArticleViews", fields: [articleId], references: [id], onDelete: Cascade)

  userId String?
  // (une seule relation User<->ArticleView, donc pas besoin de nom ici)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  viewerHash String? // hash(IP + UA) pour anonymes
  createdAt  DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([articleId, userId, createdAt])
  @@index([articleId, viewerHash, createdAt])
}

model ArticleStats {
  articleId String  @unique
  // ✅ le nom "ArticleStats" doit matcher celui côté Article
  article   Article @relation("ArticleStats", fields: [articleId], references: [id], onDelete: Cascade)

  viewsAll      Int       @default(0)
  views7d       Int       @default(0)
  views30d      Int       @default(0)
  savesAll      Int       @default(0)
  trendingScore Float     @default(0)
  lastViewedAt  DateTime?
  updatedAt     DateTime  @updatedAt
}

// ---------------- Enums ----------------
enum ReactionType {
  LIKE
  DISLIKE
  CLAP
  HEART
  FIRE
  THINK
}

enum ArticleContributionType {
  SOURCE
  NUANCE
  CONTRADICTION
  QUESTION
  CORRECTION
}

enum ArticleContributionValidationType {
  WELL_SOURCED
  ADDS_NUANCE
  NEEDS_CHECK
}

model ArticleOpinionQuestion {
  id        String   @id @default(cuid())
  articleId String   @unique
  question  String
  thesisA   String
  thesisB   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleOpinionPosition {
  id               String    @id @default(cuid())
  articleId        String
  userId           String
  selectedPosition Float?
  lacksContext     Boolean   @default(false)
  confirmedAt      DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation("UserArticleOpinionPositions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
}

model ArticleContribution {
  id            String                  @id @default(cuid())
  articleId     String
  userId        String
  type          ArticleContributionType
  text          String
  sourceUrl     String?
  needsRecalc   Boolean                 @default(false)
  bridgingScore Float                   @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  article     Article                         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User                            @relation("UserArticleContributions", fields: [userId], references: [id], onDelete: Cascade)
  validations ArticleContributionValidation[]

  @@index([articleId, bridgingScore(sort: Desc), createdAt(sort: Desc)])
  @@index([articleId, createdAt])
  @@index([needsRecalc])
  @@index([userId])
}

model ArticleContributionValidation {
  id             String                            @id @default(cuid())
  contributionId String
  userId         String
  type           ArticleContributionValidationType
  createdAt      DateTime                          @default(now())

  contribution ArticleContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User                @relation("UserArticleContributionValidations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contributionId, userId, type])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  userId    String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Threads
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Relations
  article Article @relation("ArticleComments", fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserComments", fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// ---------------- Reaction ----------------
model ArticleReaction {
  userId    String
  articleId String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  // Relations
  user    User    @relation("UserReactions", fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation("ArticleReactions", fields: [articleId], references: [id], onDelete: Cascade)

  // One reaction per (user, article) - Strict uniqueness
  @@id([userId, articleId])
  @@index([articleId])
}

// --- Enums (keep only one copy) ---
enum ChatRole {
  user
  assistant
}

enum Rigor {
  fast
  balanced
  precise
}

// --- Models ---

model ChatFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ChatSession[]

  @@unique([userId, name])
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic    String?
  mode     Rigor   @default(balanced) // rigor level persisted
  folderId String? // optional folder

  folder   ChatFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([folderId])
}

model ChatMessage {
  id String @id @default(cuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String? // null for assistant
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  role     ChatRole
  content  String
  sources  Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId, createdAt]) // ⬅️ ajouté pour le count { where: { userId } }
}

model Source {
  id          String   @id @default(uuid())
  domain      String   @unique  // ex: "lemonde.fr"
  name        String            // ex: "Le Monde"
  
  // --- SCORE FINAL ---
  trustScore  Int      @default(50) // Le résultat calculé (0-100)
  
  // --- PILIER 1 : TRANSPARENCE (Structurel) ---
  transparencyScore Int @default(0)
  isAdsTxtValid     Boolean @default(false) // ads.txt présent et valide
  isOwnerPublic     Boolean @default(false) // Propriétaire identifié (JTI)
  
  // --- PILIER 2 : PROCESSUS (Éditorial) ---
  editorialScore    Int @default(0)
  hasFactCheckFailures Boolean @default(false) // "Kill Switch" potentiel
  factCheckFailCount   Int     @default(0)     // Nombre d'erreurs répertoriées
  hasCorrectionPolicy  Boolean @default(false) // Politique de correction visible
  
  // --- PILIER 3 : SÉMANTIQUE (Contenu) ---
  semanticScore     Int @default(0)
  // biasLevel REMOVED in favor of 2-Axis System
  politicalBias     PoliticalBias @default(UNKNOWN)
  biasScore         Int           @default(0) // -100 (Left) to +100 (Right)
  reliability       Reliability   @default(UNKNOWN)
  detectedCountry   String?       @default("FR")
  
  isClickbait       Boolean @default(false)     // REMOVED: Article-specific
  
  // --- PILIER 4 : PLURALISME (Diversité des points de vue) ---
  pluralismScore    Int      @default(0)
  pluralismDetails  Json?    // { pivots: number, entities: number, controversy: number }
  // uxScore REMOVED
  
  // --- INFOS GÉNÉRALES ---
  type            String   @default("GENERAL")
  justification   String?  // Explication humaine ("Pourquoi ce score ?")
  description     String?  // Bio générée par IA
  metadata        Json?    // Métadonnées étendues (ex: owners, headquarters...)
  auditCount      Int      @default(0) // Nombre d'audits réalisés (pour la moyenne cumulative)
  lastAuditDate   DateTime?
  
  // --- EXTENSION CONSENSUS PROTOCOL ---
  // Données brutes pour la transparence
  mbfcRating       String?   // ex: "Left-Center", "Right"
  allSidesRating   String?   // ex: "Lean Left", "Center"
  adFontesScore    Float?    // Score numérique

  // Flag de validation humaine/consensus
  isConsensusVerified Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PoliticalBias {
  EXTREME_LEFT
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  EXTREME_RIGHT
  SATIRE
  UNKNOWN
}

enum Reliability {
  HIGH
  MIXED
  LOW
  PROPAGANDA
  UNKNOWN
}

enum ConfidenceLevel {
  LOW     // IA ou Import auto (Incertain)
  MEDIUM  // Vérifié historiquement
  HIGH    // Audité et Certifié par Epion
}

enum SourceType {
  AGENCY
  MEDIA
  ACADEMIC
  GOVERNMENT
  BLOG
  SOCIAL
  COMMERCIAL
  GENERAL
}

enum SourceBias {
  FAR_LEFT
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  FAR_RIGHT
  SATIRE
  UNKNOWN
}

// -----------------------------------------------------------------------------
// RAG: KNOWLEDGE CHUNKS
// -----------------------------------------------------------------------------
model KnowledgeChunk {
  id        String                 @id @default(uuid())
  content   String
  embedding Unsupported("vector(1536)")?
  articleId String
  article   Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // TODO: Fix Hnsw index syntax. Currently causing validation error P1012.
  // @@index([embedding], name: "embedding_index", type: Hnsw)
}

// -----------------------------------------------------------------------------
// BETA INVITE CODES
// -----------------------------------------------------------------------------
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(100)
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  users     User[]    @relation("UserInvite")
}

// -----------------------------------------------------------------------------
// NEWS CACHE
// -----------------------------------------------------------------------------
model NewsCache {
  id          String   @id @default(cuid())
  url         String   @unique
  domain      String
  title       String
  content     String   // Markdown extrait par Jina
  publishedAt DateTime
  createdAt   DateTime @default(now())
  // Les vecteurs et MinHash seront gérés en SQL pur
}
